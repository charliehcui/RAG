# Copy to .env locally. Never commit real keys.
OPENROUTER_API_KEY=

# Observability only. Missing key or tracing errors never stop a web test.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=multi-agent-web-testing
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Fixed paid primary endpoints. Tester falls back only on API/connection failure.
MAIN_AGENT_MODEL=deepseek/deepseek-v4-flash
MAIN_AGENT_PROVIDER=streamlake/fp8
TESTER_AGENT_MODEL=z-ai/glm-5.3-flash
TESTER_AGENT_PROVIDER=relace

# Main backup remains manual. Tester backup uses OpenRouter automatic provider failover.
MAIN_AGENT_BACKUP_MODEL=deepseek/deepseek-v3.2
MAIN_AGENT_BACKUP_PROVIDER=deepinfra/fp4
TESTER_AGENT_BACKUP_MODEL=qwen/qwen3.8-flash
TESTER_AGENT_BACKUP_PROVIDER=

# Jev remains the existing OpenRouter Decisions API selector.
JEV_MODEL=typesafe/jev-1.13

# Optional paid visual tool; leave model empty and budget at zero when unused.
COMPUTER_USE_MODEL=
COMPUTER_USE_PROVIDER=relace

DEMO_BUG_B1=false
DEMO_BUG_B2=false
DEMO_BUG_B3=false
DEMO_BUG_B4=false
DEMO_BUG_B5=false
DEMO_BUG_B6=false
FULL_EVALUATION=false
ARTIFACTS_DIR=artifacts/runs
STATE_DB_PATH=artifacts/state/shared_state.db
TEMPORARY_SENSITIVE_DIR=artifacts/temporary_sensitive
