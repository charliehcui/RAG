# Copy this file to .env and fill values locally. Never commit real keys.
GEMINI_API_KEY=
GROQ_API_KEY=

# Providers are fixed by project scope; model names remain configurable.
MAIN_AGENT_PROVIDER=gemini
MAIN_AGENT_MODEL=gemini-3.5-flash
TESTER_AGENT_PROVIDER=groq
TESTER_AGENT_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
LAYA_MODEL=english
COMPUTER_USE_PROVIDER=gemini
COMPUTER_USE_MODEL=gemini-3.5-flash

# Independent Demo App seeded-bug switches. Keep all false for normal behavior.
DEMO_BUG_B1=false
DEMO_BUG_B2=false
DEMO_BUG_B3=false
DEMO_BUG_B4=false
DEMO_BUG_B5=false
DEMO_BUG_B6=false

FULL_EVALUATION=false
ARTIFACTS_DIR=artifacts/runs
STATE_DB_PATH=artifacts/state/shared_state.db
TEMPORARY_SENSITIVE_DIR=artifacts/temporary_sensitive
